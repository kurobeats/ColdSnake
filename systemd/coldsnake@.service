# Run as the invoking user (systemd user unit) or override User= for system-wide.
[Unit]
Description=ColdSnake - upload-only Icedrive mirror
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=%i
EnvironmentFile=-/home/%i/.config/coldsnake/credentials
# venv binary, full path: system services do not read ~/.local/bin from PATH
ExecStart=/home/%i/.local/share/coldsnake/venv/bin/coldsnake mirror
TimeoutStartSec=infinity
